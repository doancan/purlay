    "@sinclair/typebox": "0.34.52",
    "@tanstack/react-query": "5.104.1",
    "lucide-react": "1.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shiki": "4.5.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
