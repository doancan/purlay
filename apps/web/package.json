    "@sinclair/typebox": "0.34.52",
    "@tanstack/react-query": "5.105.0",
    "lean-qr": "2.7.4",
    "lucide-react": "1.65.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shiki": "4.5.0",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
