# One origin in front of the API (docker-compose.production.yml, D-94).
#
# The site address is APP_URL, e.g. https://chat.example.com. Caddy obtains and
# renews a certificate for that name on its own (ACME) when the name is public and
# ports 80 and 443 reach it; for `https://localhost` it uses its internal CA, which
# is how this file is tried without a domain.
{$APP_URL} {
	# The API serves HTTP, the WebSocket upgrade and the built client on the same
	# origin (D-61), so there is one upstream and no routing here.
	#
	# Compression is the proxy's: the API sends files and JSON as they are.
	encode zstd gzip

	reverse_proxy api:3001 {
		# Only a ready node receives traffic (readiness answers 503 while it drains
		# or while migrations are pending).
		health_uri /health/ready
		health_interval 5s
	}

	# Passed to the client unchanged; the API sets its own security headers (D-39).
	#
	# The access log records the path, never the query. An OAuth callback is
	# `/auth/github/callback?code=...&state=...` — a one-time code and the signed state — and
	# a search carries what was searched for; neither belongs in a file that is shipped and
	# kept. (Caddy already redacts the Cookie and Authorization request headers.)
	log {
		output stdout
		format filter {
			wrap json
			request>uri regexp \?.* ""
		}
	}
}
