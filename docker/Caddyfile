# One origin in front of the API (docker-compose.production.yml, D-94).
#
# The site address is APP_URL, e.g. https://chat.example.com. Caddy obtains and
# renews a certificate for that name on its own (ACME) when the name is public and
# ports 80 and 443 reach it; for `https://localhost` it uses its internal CA, which
# is how this file is tried without a domain.
{$APP_URL} {
	# The API serves HTTP, the WebSocket upgrade and (later) the built client on
	# the same origin (D-61), so there is one upstream and no routing here.
	reverse_proxy api:3001 {
		# Only a ready node receives traffic (readiness answers 503 while it drains
		# or while migrations are pending).
		health_uri /health/ready
		health_interval 5s
	}

	# Passed to the client unchanged; the API sets its own security headers (D-39).
	log {
		output stdout
	}
}
