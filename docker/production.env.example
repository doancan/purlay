# The inputs of docker-compose.production.yml (D-94). Copy to production.env, fill in the empty
# values, keep the file private (it holds secrets), then:
#
#   docker compose -f docker-compose.production.yml --env-file production.env up -d --wait
#   scripts/production-init.sh
#
# Every variable is explained in docs/CONFIG.md, which owns them. A test keeps this file and the
# compose file in step: a required variable is set below and left EMPTY when it is a secret, so a
# file nobody edited stops `docker compose` naming the first one, rather than starting a stack
# with a default password. Optional variables are commented with their default.

# --- required -----------------------------------------------------------------------------------

# The API image: a digest (ghcr.io/<owner>/purlay-api@sha256:...) or a commit tag. Never a moving tag.
PURLAY_IMAGE=
# The one public https origin, no path. It is also the proxy's site address.
APP_URL=https://chat.example.com
# URL-safe, used inside DATABASE_URL:            openssl rand -hex 16
POSTGRES_PASSWORD=
# 64 hex characters:                             openssl rand -hex 32
GARAGE_RPC_SECRET=
# Garage's admin API, which prepares the store on `up` (inside the stack only): openssl rand -hex 32
GARAGE_ADMIN_TOKEN=
# Garage's own key format, GK + 24 hex digits:   echo GK$(openssl rand -hex 12)
S3_ACCESS_KEY_ID=
# 64 hex characters:                             openssl rand -hex 32
S3_SECRET_ACCESS_KEY=
# 32 random bytes, base64. Losing it makes stored integration tokens unreadable; keep it
# separately from backups:                       openssl rand -base64 32
ENCRYPTION_KEY=
# The GitHub OAuth app; its callback URL is ${APP_URL}/auth/github/callback.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- optional (defaults shown) --------------------------------------------------------------------

# LOG_LEVEL=info
# DATABASE_POOL_MAX=10
# SESSION_TTL_DAYS=30
# A Sentry-compatible DSN; unset means nothing is reported.
# ERROR_TRACKING_DSN=
# S3_REGION=us-east-1
# S3_BUCKET=purlay-attachments
# Host ports of the proxy. The HTTPS port must also be in APP_URL (https://host:8443); a certificate
# from a public CA needs 80 and 443 reachable from outside, so move them only behind another proxy
# or with certificates of your own.
# HTTP_PORT=80
# HTTPS_PORT=443
