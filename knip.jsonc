// An export nothing imports is wired up or deleted (#136, CONTRIBUTING §1.13).
//
// Knip finds the entry points itself — package scripts, the Vite config, test
// files, the ESLint config, `exports` in package.json — so what is listed here
// is only what it cannot see, and every line says why. The target is not zero
// exemptions but zero nobody can find (CONTRIBUTING §6.5): this file is the whole
// list. Nothing here is a file-by-file waiver for code that is simply dead.
{
  "$schema": "https://unpkg.com/knip@6.39.0/schema.json",

  "workspaces": {
    ".": {
      // Run by a shell script inside the API image (`backup.sh`, `restore.sh`,
      // `restore-rehearsal.sh`), which knip does not read. Not dead: the
      // backup and the restore rehearsal are these files (#274, #275).
      "entry": [
        "scripts/bucket-copy.ts",
        "scripts/rehearsal-ready.ts",
        "scripts/rehearsal-seed-bucket.ts",
      ],
    },
    "apps/api": {
      // Run by `scripts/demo.ts` as a subprocess (`bun run apps/api/src/cli/seed-demo.ts`),
      // which knip does not read. Not dead: it is how the demo and the browser tests get
      // their workspace, and it lives in `cli/` beside `write-env-example.ts` for the same reason.
      // `demo-session.ts` likewise: the browser suite's fixtures run it for a session the seed did
      // not make (`apps/web/e2e/fixtures.ts`, `freshSessionOf`). `storage-init.ts` is the command of
      // the production compose file's one-shot `storage-init` service (D-144), which knip does not read.
      // `testing/fresh-server.ts` is run by the setup wizard's browser spec (`apps/web/e2e/setup.e2e.ts`) as a
      // subprocess: a server with nobody on it, GitHub's stand-in and a relay beside it — the state `scripts/demo.ts`,
      // which seeds people, cannot give.
      // `throwaway-database.ts` is run by `scripts/budget-api.ts` as a subprocess: the scripts cannot
      // import the database package, and the API must start on a clone, never on `DATABASE_URL` itself.
      "entry": [
        "src/index.ts",
        "src/cli/seed-demo.ts",
        "src/cli/demo-session.ts",
        "src/cli/storage-init.ts",
        "src/cli/throwaway-database.ts",
        "src/testing/fresh-server.ts",
      ],
    },
    "apps/web": {
      // The first exemption. The realtime client library and the browser clock
      // that feeds it are finished and tested, and nothing imports them until the
      // client store lands (#26). Listing them as entries keeps their exports
      // out of the report until then; delete this array when #26 merges and
      // knip will say which exports, if any, the store left unused.
      "entry": ["src/realtime/*.ts", "src/system-clock.ts"],

      // A second, different kind: a dependency named only by a *string*.
      // `testing/radix-preload.ts` calls `mock.module('@radix-ui/react-use-layout-effect')`,
      // which is how Radix portals mount in a test DOM that registers after Radix is
      // imported. Knip reads imports, not strings, so it sees a devDependency nothing
      // uses; it is the one thing the preload needs and the package is a direct
      // devDependency for no other reason (#138).
      "ignoreDependencies": ["@radix-ui/react-use-layout-effect"],
    },
  },
}
