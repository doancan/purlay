{
  "name": "purlay",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "typecheck": "tsc --build --pretty",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore",
    "test": "bun test",
    "verify": "bun run typecheck && bun run lint && bun run format:check && bun test && bun run verify:enforcement",
    "verify:enforcement": "bun run scripts/verify-enforcement.ts"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@types/bun": "1.4.2",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  }
}
