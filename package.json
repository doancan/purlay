{
  "name": "purlay",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "build:web": "bun run --cwd apps/web build",
    "check:branch": "./scripts/check-branch.sh",
    "check:docs": "python3 scripts/check-docs.py",
    "check:pr": "bun run scripts/check-pr.ts",
    "config:example": "bun run apps/api/src/cli/write-env-example.ts",
    "db:check": "./scripts/check-schema.sh",
    "db:down": "docker compose down",
    "db:generate": "bun x kysely-codegen --dialect postgres --out-file packages/db/src/schema.ts --exclude-pattern 'kysely_migration*'",
    "db:logs": "docker compose logs -f",
    "db:migrate": "bun run packages/db/src/cli/migrate.ts",
    "db:reset": "docker compose down -v && docker compose up -d --wait postgres minio && docker compose up --exit-code-from minio-bucket minio-bucket",
    "db:up": "docker compose up -d --wait postgres minio && docker compose up --exit-code-from minio-bucket minio-bucket",
    "db:up:postgres": "docker compose up -d --wait postgres",
    "dev": "bun --filter '@purlay/api' --filter '@purlay/web' dev",
    "dev:api": "bun run --cwd apps/api dev",
    "dev:web": "bun run --cwd apps/web dev",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "queue": "bun run scripts/queue.ts",
    "test": "bun test apps packages scripts --path-ignore-patterns '**/*.integration.test.ts'",
    "test:integration": "bun test apps packages scripts --test-name-pattern '^integration'",
    "test:all": "bun run scripts/test-all.ts",
    "typecheck": "tsc --build --pretty",
    "typecheck:ts6": "tsc6 --build --force --pretty",
    "verify": "bun run check:branch && bun run typecheck && bun run typecheck:ts6 && bun run lint && bun run format:check && bun run test:all && bun run build:web && bun run verify:enforcement && bun run check:docs && bun run config:example -- --check",
    "verify:enforcement": "bun run scripts/verify-enforcement.ts"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.1",
    "@types/bun": "1.4.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.10.0",
    "kysely-codegen": "0.20.0",
    "prettier": "3.9.6",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.70.0"
  }
}
