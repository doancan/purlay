{
  "name": "purlay",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "zod": "^4.6.6"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "audit:gate": "bun run scripts/audit.ts --today $(date -u +%F)",
    "budget:api": "bun --no-env-file --env-file=.env.test run scripts/budget-api.ts",
    "budget:browser": "bun --no-env-file --env-file=.env.test run apps/api/src/cli/budget-browser.ts",
    "budget:latency": "bun --no-env-file --env-file=.env.test run scripts/budget-latency.ts",
    "measure:frames": "bun run apps/api/src/cli/frame-profiles.ts",
    "report:frames": "bun run apps/api/src/cli/frame-report.ts",
    "push:keys": "bun run apps/api/src/cli/push-keys.ts",
    "budget:web": "bun --no-env-file run scripts/budget-web.ts",
    "build:web": "bun run --cwd apps/web build",
    "check:branch": "./scripts/check-branch.sh",
    "ci:changes": "bun run scripts/ci-changes.ts",
    "check:docs": "python3 scripts/check-docs.py",
    "check:licenses": "bun run scripts/check-licenses.ts",
    "check:pr": "bun run scripts/check-pr.ts",
    "check:cla": "bun run scripts/check-cla.ts",
    "contract:bundle": "bun run apps/api/src/cli/contract-bundle.ts",
    "config:example": "bun run apps/api/src/cli/write-env-example.ts",
    "db:check": "./scripts/check-schema.sh",
    "db:down": "docker compose down",
    "db:generate": "bun x kysely-codegen --dialect postgres --out-file packages/db/src/schema.ts --include-pattern 'public.*' --exclude-pattern 'public.kysely_migration*'",
    "db:logs": "docker compose logs -f",
    "db:prune": "bun --no-env-file --env-file=.env.test run scripts/prune-databases.ts",
    "db:migrate": "bun run packages/db/src/cli/migrate.ts",
    "db:reset": "docker compose down -v && docker compose up -d --wait postgres garage && ./scripts/storage-init.sh",
    "db:up": "docker compose up -d --wait postgres garage && ./scripts/storage-init.sh",
    "db:up:postgres": "docker compose up -d --wait postgres",
    "demo": "bun --no-env-file --env-file=.env.test run scripts/demo.ts",
    "dev": "bun run scripts/dev.ts",
    "dev:api": "bun run --cwd apps/api dev",
    "dev:web": "bun run --cwd apps/web dev",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore",
    "job": "bun run apps/api/src/cli/jobs.ts",
    "export:workspace": "bun run apps/api/src/cli/export-workspace.ts",
    "erase:content": "bun run apps/api/src/cli/erase-content.ts",
    "admin:reset-password": "bun run apps/api/src/cli/admin-reset-password.ts",
    "storage:quota": "bun run apps/api/src/cli/storage-quota.ts",
    "knip": "knip",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "mutate": "bun run scripts/run-mutations.ts",
    "queue": "bun run scripts/queue.ts",
    "release": "bun run scripts/release.ts",
    "schedule": "bun run apps/api/src/cli/schedule.ts",
    "test": "bun --no-env-file --env-file=.env.test test apps packages scripts --path-ignore-patterns '**/*.integration.test.ts'",
    "test:all": "bun --no-env-file --env-file=.env.test run scripts/test-all.ts",
    "test:e2e": "bun --no-env-file --env-file=.env.test run --filter @purlay/web e2e",
    "test:e2e:install": "bunx playwright install --with-deps chromium",
    "test:e2e:update": "bun --no-env-file --env-file=.env.test run --filter @purlay/web e2e:update",
    "test:integration": "bun --no-env-file --env-file=.env.test test apps packages scripts --test-name-pattern '^integration'",
    "test:storage": "bun --no-env-file --env-file=.env.test test ./apps/api/src/platform/storage.s3-check.ts",
    "tokens:check": "bun run packages/tokens/src/cli.ts --check",
    "tokens:generate": "bun run packages/tokens/src/cli.ts",
    "typecheck": "tsc --build --pretty",
    "typecheck:ts6": "tsc6 --build --force --pretty",
    "verify": "bun run check:branch && bun run typecheck && bun run typecheck:ts6 && bun run lint && bun run knip && bun run format:check && bun run test:all && bun run build:web && bun run budget:web && bun run budget:api && bun run budget:latency && bun run verify:enforcement && bun run check:docs && bun run config:example -- --check && bun run tokens:check",
    "verify:enforcement": "bun run scripts/verify-enforcement.ts"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.1",
    "@types/bun": "1.4.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.13.0",
    "eslint-plugin-compat": "7.0.2",
    "knip": "6.41.0",
    "kysely-codegen": "0.20.0",
    "prettier": "3.9.10",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.2"
  }
}
